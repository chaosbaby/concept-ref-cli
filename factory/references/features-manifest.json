[
  {
    "id": "fts-engine",
    "category": "Core",
    "label": "FTS5 全文索引",
    "description": "基于 SQLite FTS5 的高性能搜索。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "search",
      "flags": ["--limit", "--field"]
    }
  },
  {
    "id": "pipe-stream",
    "category": "Core",
    "label": "Unix 管道流",
    "description": "支持从 stdin 读取查询及结果管道输出。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "search",
      "flags": ["--stdin", "-"]
    }
  },
  {
    "id": "unified-output-protocol",
    "category": "Interop",
    "label": "标准输出协议",
    "description": "支持 show(精装), plain(原味), json(结构化) 三大模式。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "search",
      "flags": ["-o show", "-o plain", "-o json"]
    }
  },
  {
    "id": "rich-render-engine",
    "category": "UX",
    "label": "智能排版引擎",
    "description": "根据数据内容（如诗词、长文）自动触发垂直排版或分段。",
    "status": "recommended",
    "trigger": {
      "type": "field_check",
      "pattern": "^(content|text|desc|fulltext|poem)$"
    },
    "cli_integration": {
      "command": "search",
      "flags": ["-o show"]
    }
  },
  {
    "id": "sub-command-isolation",
    "category": "Architecture",
    "label": "子命令隔离",
    "description": "不同功能源拥有独立命令空间（如 lexicon dict）。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "<source>",
      "flags": ["search"]
    }
  },
  {
    "id": "param-filtering",
    "category": "Retrieval",
    "label": "多维参数过滤",
    "description": "支持按词长、频率、标签进行区间过滤。",
    "status": "recommended",
    "trigger": {
      "type": "field_check",
      "pattern": "^(rank|freq|tag|len)$"
    },
    "cli_integration": {
      "command": "dict",
      "flags": ["--rank-min", "--len-min", "--tag"]
    }
  },
  {
    "id": "rank-sorting",
    "category": "Retrieval",
    "label": "权重智能排序",
    "description": "根据热度字段自动优化结果顺序。",
    "status": "recommended",
    "trigger": {
      "type": "field_check",
      "pattern": "^(rank|freq|hot)$"
    },
    "cli_integration": {
      "command": "search",
      "flags": ["--sort"]
    }
  },
  {
    "id": "multi-layer-dedup",
    "category": "Data",
    "label": "多层去重",
    "description": "在加载时基于指纹自动去重。",
    "status": "recommended",
    "trigger": {
      "type": "conflict_risk",
      "condition": "duplicate_keys"
    },
    "cli_integration": {
      "command": "init",
      "flags": ["--dedup"]
    }
  },
  {
    "id": "shell-completion-manager",
    "category": "UX",
    "label": "补全管理器",
    "description": "提供 show (源码展示) 和 install (自动注入) 功能。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "completion",
      "flags": ["show", "install"]
    }
  },
  {
    "id": "auto-completion-engine",
    "category": "UX",
    "label": "内建补全引擎",
    "description": "毫秒级前缀匹配补全接口。",
    "status": "recommended",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "complete",
      "flags": []
    }
  },
  {
    "id": "config-manager",
    "category": "UX",
    "label": "配置管理",
    "description": "持久化用户默认参数（如默认输出模式）。",
    "status": "optional",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "config",
      "flags": ["set", "get"]
    }
  },
  {
    "id": "interactive-pick",
    "category": "UX",
    "label": "随机灵感捡拾",
    "description": "随机返回高质量词条。",
    "status": "optional",
    "trigger": {
      "type": "volume_check",
      "min_records": 1000
    },
    "cli_integration": {
      "command": "pick",
      "flags": ["--count"]
    }
  },
  {
    "id": "direct-sql",
    "category": "Expert",
    "label": "SQL 直连",
    "description": "直接执行 SQLite 语句。",
    "status": "optional",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "sql",
      "flags": []
    }
  },
  {
    "id": "doctor-stat",
    "category": "Maintenance",
    "label": "健康诊断",
    "description": "DB 完整性及统计分布检查。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "doctor",
      "flags": []
    }
  },
  {
    "id": "schema-reflection",
    "category": "Core",
    "label": "Schema 自省",
    "description": "输出底层数据库字段定义。",
    "status": "mandatory",
    "trigger": {
      "type": "always"
    },
    "cli_integration": {
      "command": "schema",
      "flags": []
    }
  },
  {
    "id": "batch-loader",
    "category": "Data",
    "label": "工业级加载器",
    "description": "多线程加载大规模碎片 JSON/TSV。",
    "status": "recommended",
    "trigger": {
      "type": "source_pattern",
      "pattern": ".*\\.json$"
    },
    "cli_integration": {
      "command": "init",
      "flags": ["--batch-size"]
    }
  }
]
